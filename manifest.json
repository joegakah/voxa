{
  "manifest_version": 3,
  "name": "Voxa",
  "version": "1.0.0",
  "description": "Hover over any paragraph or select text and hear it read aloud. Detects the language automatically.",
  "permissions": ["storage", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "options_page": "options.html",
  "commands": {
    "read-selection": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Read the selected text aloud"
    }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Voxa settings" }
}
